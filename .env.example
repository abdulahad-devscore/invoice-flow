# Copy to .env. Defaults work for a local demo.
# REGISTRY=mirror.gcr.io            # if Docker Hub rate-limits you

# llm = Claude extraction (needs ANTHROPIC_API_KEY); rules = offline parser for the bundled demo layouts only
EXTRACTOR=llm
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5
EXTRACT_FALLBACK_MODEL=claude-opus-5-5

INVOICE_DB_PASSWORD=invoices
HUMAN_REVIEW_TIMEOUT_HOURS=72

# Scanned PDFs: enable AWS Textract (otherwise Claude reads the page images)
TEXTRACT_ENABLED=false
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bridge credentials (demo default)
BRIDGE_CLIENT_SECRET=invoice-flow-demo-secret
