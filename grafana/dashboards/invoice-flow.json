          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(received_at, 1h), status AS metric, count(*) AS value FROM invoices WHERE $__timeFilter(received_at) GROUP BY 1, 2 ORDER BY 1"
