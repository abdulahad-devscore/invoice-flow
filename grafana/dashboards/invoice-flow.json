    {
      "id": 9,
      "type": "table",
      "title": "Exceptions needing attention",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "invoices-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "invoices-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT received_at AS \"Received\", status AS \"Status\", supplier_name AS \"Supplier\", supplier_invoice_number AS \"Invoice\", po_number AS \"PO\", amount_total AS \"Total (RM)\", coalesce(reviewer || ': ' || review_note, reason) AS \"Reason\" FROM invoices WHERE status IN ('waiting_for_human', 'failed', 'rejected', 'duplicate') ORDER BY received_at DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Machine time vs. time waiting (review or dead-letter replay), minutes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "invoices-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "xField": "Invoice",
        "stacking": "normal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "invoices-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT supplier_invoice_number AS \"Invoice\", round((processing_seconds / 60.0)::numeric, 2) AS \"Machine\", round((greatest(extract(epoch FROM completed_at - received_at) - processing_seconds, 0) / 60.0)::numeric, 2) AS \"Waiting for review\" FROM invoices WHERE completed_at IS NOT NULL AND $__timeFilter(received_at) ORDER BY received_at DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
